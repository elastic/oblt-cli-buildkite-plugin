#!/usr/bin/env bash

set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

_default_username="${BUILDKITE_REPO:+$(basename "${BUILDKITE_REPO}" .git)}"
OBLT_CLI_USERNAME="${BUILDKITE_PLUGIN_OBLT_CLI_USERNAME:-${_default_username:-obltmachine}}"
OBLT_CLI_SLACK_CHANNEL="${BUILDKITE_PLUGIN_OBLT_CLI_SLACK_CHANNEL:-#observablt-bots}"
OBLT_CLI_VERSION="${BUILDKITE_PLUGIN_OBLT_CLI_VERSION:-}"
OBLT_CLI_VERSION_FILE="${BUILDKITE_PLUGIN_OBLT_CLI_VERSION_FILE:-"${DIR}/../.default-oblt-cli-version"}"

if [[ -z ${VAULT_GITHUB_TOKEN} ]]; then
	>&2 echo "The VAULT_GITHUB_TOKEN environment variable must be set."
	exit 1
fi

# shellcheck disable=SC1091
. "${DIR}/../lib/setup.bash"

git config --global user.name "${GIT_USER:-"${OBLT_CLI_USERNAME}"}"
git config --global user.email "${GIT_EMAIL:-"${OBLT_CLI_USERNAME}@users.noreply.github.com"}"

VERSION=$(get_version_from_input_or_file "${OBLT_CLI_VERSION}" "${OBLT_CLI_VERSION_FILE}")
echo "~~~ :elastic-apm: Set up oblt-cli ${VERSION}"
setup "${VERSION}" "${OBLT_CLI_USERNAME}" "${OBLT_CLI_SLACK_CHANNEL}" "${OBLT_CLI_BIN}"

OBLT_CLI_COMMAND="${BUILDKITE_PLUGIN_OBLT_CLI_COMMAND:-}"

if [[ "${OBLT_CLI_COMMAND}" == "credentials" ]]; then
	OBLT_CLI_CLUSTER_NAME="${BUILDKITE_PLUGIN_OBLT_CLI_CLUSTER_NAME:-}"
	if [[ -z "${OBLT_CLI_CLUSTER_NAME}" ]]; then
		>&2 echo "The cluster-name input is required when command is 'credentials'."
		exit 1
	fi
	echo "~~~ :elastic-apm: Fetching credentials for cluster ${OBLT_CLI_CLUSTER_NAME}"
	ENV_FILE=$(mktemp)
	trap 'rm -f "${ENV_FILE}"' EXIT
	oblt-cli cluster secrets env --cluster-name "${OBLT_CLI_CLUSTER_NAME}" --output-file "${ENV_FILE}"
	while IFS= read -r line || [[ -n "${line}" ]]; do
		key="${line%%=*}"
		value="${line#*=}"
		[[ -z "${key}" || "${key}" == \#* ]] && continue
		if [[ -n "${value}" ]]; then
			(
				_secret_file=$(mktemp)
				trap 'rm -f "${_secret_file}"' EXIT
				printf '%s' "${value}" > "${_secret_file}"
				buildkite-agent redactor add "${_secret_file}"
			)
		fi
		export "${key}=${value}"
	done < "${ENV_FILE}"
	rm -f "${ENV_FILE}"
fi
